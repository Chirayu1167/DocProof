LLM_PROVIDER=groq        # gemini | openai | groq
LLM_API_KEY=your-key-here
LLM_MODEL=openai/gpt-oss-120b # gemini e.g. gemini-3.8-flash | openai e.g. gpt-5-mini | groq e.g. openai/gpt-oss-120b (empty = provider default)
OPENAI_API_KEY=            # only needed for EMBEDDING_PROVIDER=openai (falls back to LLM_API_KEY when LLM_PROVIDER=openai)
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=local   # local | openai (any failure falls back to BM25-only retrieval)
OCR_PROVIDER=local         # local (requires Tesseract binary + pytesseract; without it, native PDF text still works and image docs report a warning)
MIN_SIM=0.40               # dense-similarity floor for the no-match short-circuit (BM25 hits always pass through)
